__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# generated outputs are regeneratable from the drivers; LFP outputs are large
# (per-band memmaps, drop-in .mat) and must never be committed as data.
results/*.csv
results/*.pkl
results/*.npz
results/*.npy
results/*.mat
results/*.dat
results/**/*.csv
results/**/*.pkl
results/**/*.npz
results/**/*.npy
results/**/*.mat
results/**/*.dat
figures/*.png
figures/*.svg
figures/**/*.png
figures/**/*.svg

# ...except the per-cohort result tables, which underwrite every number in the
# NOTES entries and cost a full re-scan of ~140 GB of voltage to regenerate.
!results/lfp_inventory_*.csv
!results/lfp_identity_matrix_*.csv
!results/lfp_bandpower_summary_*.csv
!results/lfp_bandpower_validation_*.csv
!results/lfp_arms_evolution_*.csv
!results/lfp_arms_decoding_*.csv
!results/lfp_arms_reliability_*.csv
!results/lfp_arms_cca_*.csv
!results/lfp_arms_moving_reliability_epochs_*.csv
# The per-trial moving table is ~40k rows per cohort and is derivable from the
# epoch rollup plus the cached band power; not tracked.
results/lfp_arms_moving_reliability_task.csv
results/lfp_arms_moving_reliability_control.csv
!results/lfp_arms_behaviour_*.csv
!results/lfp_group_contrast.csv
!results/lfp_probe2_clock_audit.csv
# Across-animal test tables (2026-09-25): small, and they carry every verdict.
!results/lfp_arms_decoding_stats_*.csv
!results/lfp_arms_cca_distance_stats_*.csv
!results/lfp_psi_stats_*.csv
!results/lfp_distance_stats_*.csv
# console captures duplicate the pipeline_*.log files
results/*.out
